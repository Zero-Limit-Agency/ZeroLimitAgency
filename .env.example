NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ZERO_LIMIT_EMAIL_FROM=
PUBLIC_CONTACT_EMAIL=contact@zerolimit.agency
INSCRIPTIONS_EMAIL=inscription@zerolimit.agency
CLIENT_EMAIL=client@zerolimit.agency
CLIENT_SUPPORT_EMAIL=contact@zerolimit.agency
CLIENT_DISCORD_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
GOOGLE_DRIVE_LEADS_ROOT_FOLDER_ID=

EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY_MS=500

# Discord bot public pages
NEXT_PUBLIC_DISCORD_BOT_NAME=Bot Discord Zero Limit Agency
NEXT_PUBLIC_DISCORD_BOT_INVITE_URL=
NEXT_PUBLIC_DISCORD_APPLICATION_ID=

# Security hardening
# Internal diagnostics are disabled by default. Keep false in Production and Preview unless explicitly needed for a short, authorized investigation.
ENABLE_INTERNAL_DIAGNOSTICS=false
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store only in server-side Vercel environment variables. Never expose as NEXT_PUBLIC_*.
OAUTH_TOKEN_ENCRYPTION_KEY=
# Use "redis" with a Vercel-compatible Redis/Upstash REST endpoint for distributed limits, or "local" only for development fallback.
RATE_LIMIT_PROVIDER=local
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
RATE_LIMIT_FAIL_CLOSED=false
TRUST_PROXY_IP_HEADERS=false
RATE_LIMIT_KEY_PREFIX=zla:rate-limit
## Explicit temporary gate for pre-billing interactive space provisioning.
## Preview/dev can omit it; production must opt in deliberately with "enabled".
ZERO_LIMIT_INTERACTIVE_PROVISIONING=

# Billing provider (server-only). Use sk_test_ in development/Preview and sk_live_ only in Production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# JSON object mapping environment-specific provider Price IDs to internal plan keys.
STRIPE_PRICE_MAP_JSON={}
